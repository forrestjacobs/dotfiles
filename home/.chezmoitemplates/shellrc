# Generated by template

{{ $cachePath := (printf "$HOME/.cache/dotfiles/%s" .shell.name) -}}
cache_path="{{ $cachePath }}"
test -d "$cache_path" || mkdir -p "$cache_path"
p_source () {
  file_path="$cache_path/${1##*/}"
  if cmd_path="$(command -v "$1")"; then
    [[ "$cmd_path" -ot "$file_path" ]] || $* > "$file_path"
    . "$file_path"
  fi
}

add_path () {
  [[ ":$PATH:" == *":$1:"* ]] || export PATH="$1:$PATH"
}

{{ range $envName, $envValue := .shell.env -}}
export {{ $envName }}="{{ $envValue }}"
{{ end }}

p_source {{ if eq .chezmoi.os "darwin" }}/opt/homebrew{{ else }}/home/linuxbrew/.linuxbrew{{ end }}/bin/brew shellenv "{{ .shell.name }}"

{{ range $path := .shell.paths -}}
add_path "{{ $path }}"
{{ end }}

{{ range $abbrName, $abbrValue := .shell.abbr -}}
alias {{ $abbrName }}="{{ $abbrValue }}"
{{ end }}

p_source fzf "--{{ .shell.name }}"
p_source starship init "{{ .shell.name }}" --print-full-init
p_source zoxide init "{{ .shell.name }}"
